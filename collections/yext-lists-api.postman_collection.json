          "id": "0c809ec3-ece3-40e8-bd2f-5585688b9b1b",
          "name": "Get List",
          "request": {
            "name": "Get List",
            "description": {
              "content": "Use Get List to retrieve Enhanced Content List (ECL) content in the following use cases:\n1. Fetch the HTML for a specific type of List.\n  * **Use listingId, template**\n  * Response will be rendered into a template and returned for direct display to the user\n2. Fetch the structured data (JSON) for a specific List\n  * **Use listingId, listId**\n3. Fetch the structured data (JSON) for a specific type of List\n  * **Use listingId, type**\n4. Fetch the structured data (JSON) for all Lists associated with a listing\n  * **Use listingId**\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "lists"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "Publisher secure ID. This value will be provided to you.\n"
                },
                {
                  "disabled": false,
                  "key": "listingId",
                  "value": "<string>",
                  "description": "Publisher listing ID\n"
                },
                {
                  "disabled": false,
                  "key": "yextId",
                  "value": "<string>",
                  "description": "The Yext listing ID\n"
                },
                {
                  "disabled": false,
                  "key": "listId",
                  "value": "<string>",
                  "description": "ECL ID (Yext-assigned)\n"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Type of lists to return\n"
                },
                {
                  "disabled": false,
                  "key": "template",
                  "value": "<string>",
                  "description": "This parameter specifies the template to use when rendering the List content.\nYext will provide a list of your available templates. Yext configures each template with the type of data that it accepts -- for example, the template \"mobile-menu\" may be configured to render all Lists on a listing of type MENU.\n* If no template is specified, all List data will be rendered using a default template\n* Required if fetching HTML\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "An alternative way to specify the desired content type of the response\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
