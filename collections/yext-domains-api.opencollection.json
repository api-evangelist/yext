      "items": [
        {
          "info": {
            "name": "Domain: List\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.yextapis.com/v2/accounts/:accountId/domains",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "v",
                "value": "",
                "type": "query",
                "description": "A date in `YYYYMMDD` format."
              },
              {
                "name": "hostname",
                "value": "www.example.com,test.example.com",
                "type": "query",
                "description": "Exact hostname(s) to filter results by. If not provided, results for all hostnames will be returned."
              },
              {
                "name": "hostname_search",
                "value": "example",
                "type": "query",
                "description": "Case-insensitive substring used to filter by hostname."
              },
              {
                "name": "show_deleted",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page. Sizes above the maximum will be clamped at the maximum value."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Token to retrieve the next page of results. If not provided, the first page of results will be returned."
              },
              {
                "name": "view",
                "value": "",
                "type": "query",
                "description": "`FULL` returns all details, while `BASIC` omits certain SSL information.\nUsing `BASIC` will also usually result in a lower response latency relative to using `FULL`.\n"
              }
            ]
          },
          "docs": "Domain: List\n"
        },
