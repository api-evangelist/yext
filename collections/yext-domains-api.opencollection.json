                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "force_move",
                "value": "",
                "type": "query",
                "description": "If true, and the domain is in a MOVE_REQUIRED state, will move ownership of the domain to this account."
              },
              {
                "name": "update_mask",
                "value": "",
                "type": "query",
                "description": "A comma-separated list of fields to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the configurations for the specified domain. Also triggers a check for Yext or SSL verification, if the Domain is not yet ACTIVE.\nSee the `update_mask` parameter for fields that can be updated, any other provided fields will be ignored.\n"
        },
