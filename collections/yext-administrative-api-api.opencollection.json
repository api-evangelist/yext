{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yext Admin Account Settings Administrative API API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
